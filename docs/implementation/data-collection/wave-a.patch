+        {
+          "title": "原题 PDF",
+          "url": "/problem-files/comap-2023-mcm-y/problem.pdf",
+          "kind": "problem",
+          "bytes": 518290,
+          "sha256": "bbbda23fa35c1e522e6f6ee2d5d27563cd7067ace724b26bf15fac3bfb202555"
+        }
+      ],
+      "content_format": "structured_text",
+      "content_status": "complete",
+      "content_character_count": 6002,
