+      "status": "完整题面",
+      "summary": "| ©2023 by COMAP, Inc. | www.comap.com | www.mathmodels.org | info@comap.com |",
+      "source_id": "comap_mcm_icm",
+      "source_url": "https://www.comap.org/membership/member-resources/item/understanding-used-sailboat-prices",
