+    {
+      "id": "comap-2023-mcm-y",
+      "code": "2023 MCM Y",
+      "title": "Understanding Used Sailboat Prices",
+      "competition": "COMAP MCM/ICM",
+      "category": "美赛",
+      "year": 2023,
