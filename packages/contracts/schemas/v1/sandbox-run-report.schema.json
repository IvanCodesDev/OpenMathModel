{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmathmodel.contracts.v1.sandbox-run-report",
  "title": "SandboxRunReport",
  "description": "沙盒 Agent 的执行报告（设计 D1.4）：一次「写码→运行→读产物→修复」任务的可审计结论。验收以 assertions 为准（父节点给定的确定性校验），不接受模型自述成功；父节点从 metrics_source_artifact 读真实数字拼 StageOutput（数字冻结纪律的源头）。",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["passed", "failed"],
      "description": "passed=全部断言通过；failed=断言未全过或运行失败（明细见 assertions 与 attempts）。"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "description": "实际执行的运行轮数（R2 修复每轮计一次）。"
    },
    "final_code_artifact": {
      "type": "string",
      "description": "最终版本代码的 artifact id（可复现入口）。"
    },
    "produced_artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本次任务产出的全部 artifact id 列表；无产物为空列表。"
    },
    "metrics_source_artifact": {
      "type": ["string", "null"],
      "description": "唯一指标来源的 artifact id（如 metrics.json）；无指标类任务（纯清洗/渲染）为 null。"
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion_result" },
      "description": "验收断言逐条结果（断言由父节点给定）；空列表 = 父节点未给断言（仅以运行成功为准，须在消费方显式声明）。"
    },
    "seeds": {
      "type": "object",
      "description": "本次运行使用的显式随机种子（名称 → 值），可复现性硬要求（§7.3）。",
      "additionalProperties": { "type": ["integer", "string"] }
    },
    "env_fingerprint": { "$ref": "#/$defs/env_fingerprint" },
    "usage": { "$ref": "#/$defs/usage" }
  },
  "required": [
    "status",
    "attempts",
    "final_code_artifact",
    "produced_artifacts",
    "metrics_source_artifact",
    "assertions",
    "seeds",
    "env_fingerprint",
    "usage"
  ],
  "additionalProperties": false,
  "$defs": {
    "assertion_result": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "断言标识（父节点任务卡中的编号）。" },
        "passed": { "type": "boolean" },
        "detail": {
          "type": "string",
          "description": "断言的判定说明；失败时必须携带可定位的差异信息。"
        }
      },
      "required": ["id", "passed", "detail"],
      "additionalProperties": false
    },
    "env_fingerprint": {
      "type": "object",
      "properties": {
        "runtime": { "type": "string", "description": "语言运行时（如 python）。" },
        "version": { "type": "string", "description": "运行时版本号。" },
        "deps_hash": {
          "type": "string",
          "description": "依赖清单的内容哈希；同指纹 + 同种子 + 同数据 = 指标应一致（浮点容差内）。"
        }
      },
      "required": ["runtime", "version", "deps_hash"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "runs": { "type": "integer", "minimum": 0, "description": "沙箱运行次数。" },
        "tokens": { "type": "integer", "minimum": 0, "description": "本任务消耗的 LLM tokens。" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      },
      "required": ["runs", "tokens", "duration_ms"],
      "additionalProperties": false
    }
  }
}
