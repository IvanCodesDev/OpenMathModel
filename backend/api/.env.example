# 复制本文件为 backend/api/.env 并填入真实值（.env 已被 .gitignore 排除，绝不入库）

# ── QQ 邮箱 SMTP（注册验证码真实发信） ─────────────────────────
# 授权码获取：QQ邮箱网页版 → 设置 → 账户 → POP3/IMAP/SMTP服务 → 开启服务 → 生成授权码
OMM_SMTP_HOST=smtp.qq.com
OMM_SMTP_PORT=465
OMM_SMTP_STARTTLS=false
OMM_SMTP_USER=你的QQ号@qq.com
OMM_SMTP_PASSWORD=16位SMTP授权码（不是QQ密码）
# 注意：QQ 邮箱要求发件人必须与登录账号一致
OMM_SMTP_FROM=OpenMathModel <你的QQ号@qq.com>

# ── 其他可选覆盖 ───────────────────────────────────────────────
# OMM_DATABASE_URL=postgresql+psycopg://openmathmodel:openmathmodel@127.0.0.1:5433/openmathmodel
# OMM_SECRET_KEY=生产环境请改为强随机值
